  "controls": {
    "answeringModel": {
      "name": "gpt-6.1-sol",
      "revision": "2026-09-29",
      "api": "Azure OpenAI Responses v1",
      "reasoningEffort": "medium",
      "maxOutputTokens": 8000,
      "maxAttempts": 3,
      "store": false,
      "automaticTruncation": false
    },
    "context": {
      "conversationAllowancePerRun": 200000,
      "scope": "per task session and per comparison member, not pooled",
      "increasePolicy": "Raise identically for all members before a new comparison or label separate context-limited task; never score a capacity refusal as index quality"
    },
    "strategies": [
      "current-v1",
      "custom-structured-v1",
      "microsoft-indexer-layout-v1"
    ],
    "query": {
      "mode": "vector",
      "top": 8,
      "includeNeighbors": true,
      "embeddingModel": "text-embedding-3-large",
      "dimensions": 3072,
      "dataType": "float16",
      "partitionKeyPaths": [
        "/libraryId",
        "/documentId"
      ],
      "vectorShardKey": "/libraryId",
      "index": "diskANN",
      "tuning": "existing defaults"
    },
    "chunking": {
      "current-v1": {
        "targetTokens": 500,
        "overlapTokens": 50,
        "boundaryPolicy": "section/sentence"
      },
      "custom-structured-v1": {
        "targetTokens": 500,
        "overlapTokens": 50,
        "boundaryPolicy": "original-source blocks then section/sentence"
      },
      "microsoft-indexer-layout-v1": {
        "targetTokens": 5000,
        "overlapCharacters": 200
      },
      "controlledComponent": {
        "targetTokens": 500,
        "overlap": 0,
        "unit": "tokens and characters both zero; same pinned layout extraction"
      }
    },
    "runtimePins": "Actual profile snapshots, generation/contentRevision/metadataVersion, embedding model revision, prompt/tool/source/code hashes and SDK versions are captured in each private runtime snapshot and sanitized receipt; missing values are unavailable, never inferred.",
    "heldoutUse": "Source-authoring inspection only in R0; no answering/extraction selection on heldout; confirm finalists once in I1.",
    "minimumUsefulImprovement": {
      "relativeEfficiency": 0.2,
      "observedSourceQualityRegressionAllowed": 0,
      "interpretation": "Provisional selection gate, not statistical equivalence; retain simpler baseline when inconclusive."
    },
    "measurement": {
      "estimated": [
        "cl100k_base source and serialized evidence tokens"
      ],
      "measured": [
        "elapsed times",
        "actual source bytes and chunk distributions",
        "provider token counters when reported",
        "known Cosmos RU with completeness"
      ],
      "unavailableUnlessReported": [
        "billed currency",
        "connector embedding usage",
        "workflow actions",
        "standing host allocation",
        "unknown failed-call usage"
      ]
    }
  }
