#!/bin/sh
# Local dependencies and checks only. Never source cloud configuration here.
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$project_dir"
action=${1:-check}
if [ "$#" -gt 0 ]; then shift; fi

if [ "$action" = setup ]; then
    bootstrap_python=${FLI_PYTHON:-python3}
    "$bootstrap_python" -c 'import sys; assert sys.version_info >= (3, 12), "Python 3.12+ is required"'
    if [ -L .venv ]; then
        echo 'Refusing a shared/symlinked .venv; each worktree needs its own environment.' >&2
        exit 1
    fi
    if [ ! -x .venv/bin/python ]; then
        "$bootstrap_python" -m venv .venv
    fi
fi

if [ ! -x .venv/bin/python ]; then
    echo 'Run sh scripts/dev setup first.' >&2
    exit 1
fi
if [ -L .venv ]; then
    echo 'Refusing a shared/symlinked .venv.' >&2
    exit 1
fi

case "$action" in
    setup)
        .venv/bin/python -m pip install --disable-pip-version-check --no-deps -r requirements-local.lock
        .venv/bin/python -m pip install --disable-pip-version-check --no-build-isolation --no-deps -e '.[dev,demo,comparison]'
        .venv/bin/python -m pip check
        .venv/bin/python -c 'import tiktoken; tiktoken.get_encoding("cl100k_base")'
        sh scripts/dev doctor
        ;;
    doctor)
        .venv/bin/python - <<'PY'
from importlib.metadata import version
from pathlib import Path
import sys
import fli

root = Path.cwd().resolve()
assert Path(sys.prefix).resolve() == root / ".venv", "environment belongs to another checkout"
assert Path(fli.__file__).resolve().parent == root / "src/fli", "editable install belongs to another checkout"
print(f"Python {sys.version.split()[0]}; isolated environment and editable source verified")
for name in ("azure-cosmos", "openai", "pytest", "ruff", "tiktoken"):
    print(f"{name}=={version(name)}")
PY
        ;;
    test)
        sh scripts/dev doctor
        exec .venv/bin/python -m pytest "$@"
        ;;
    lint)
        .venv/bin/python -m ruff check . "$@"
        .venv/bin/python -m ruff format --check .
        ;;
    privacy) exec .venv/bin/python -m scripts.check_reference_privacy "$@" ;;
    check)
        sh scripts/dev test "$@"
        sh scripts/dev lint
        sh scripts/dev privacy
        ;;
    *) echo 'Usage: sh scripts/dev {setup|doctor|test|lint|privacy|check} [arguments]' >&2; exit 2 ;;
esac
